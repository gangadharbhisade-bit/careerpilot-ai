# Root Vercel Environment Variables Example

# --- FRONTEND CONFIGURATION ---
VITE_API_URL=https://your-careerpilot-backend.vercel.app

# --- BACKEND & SECURITY CONFIGURATION ---
SECRET_KEY=careerpilot-ai-super-secret-jwt-key-2026-secure-hash
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-careerpilot-frontend.vercel.app,https://careerpilot-ai.vercel.app

# --- DATABASE CONFIGURATION ---
# Leave empty for SQLite in /tmp (Vercel serverless default), or provide PostgreSQL URL (Supabase / Neon)
DATABASE_URL=postgresql://user:password@host.supabase.co:5432/postgres

# --- AI PROVIDER CREDENTIALS ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
