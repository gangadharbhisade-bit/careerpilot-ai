# ==========================================
# CareerPilot AI — Environment Configuration
# ==========================================

# Environment Mode: development | production | test
ENVIRONMENT=production

# JWT Authentication Secret Key (Required)
SECRET_KEY=generate_a_secure_random_64_character_hex_string

# Database URL
# Local Dev Default: sqlite:///./careerpilot.db
# Production (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb

# AI Provider API Keys (At least GEMINI_API_KEY required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend API URL (Used by Frontend build when deployed separately)
VITE_API_URL=https://careerpilot-ai-backend.onrender.com

# Backend Allowed Origins (Comma-separated list or regex pattern)
ALLOWED_ORIGINS=https://careerpilot-ai-frontend.onrender.com,https://careerpilot-ai.vercel.app
FRONTEND_URL=https://careerpilot-ai-frontend.onrender.com
